# Not supported on the `encephalon` branch: the session there is
# GPG-encrypted, so start the mount by hand (`protondrive-nemo mount`) after
# gpg-agent is unlocked. This unit sets no PROTONDRIVE_NEMO_GPG_RECIPIENT,
# starts at login before the agent is unlocked and runs dist/cli.js through
# nvm, not the Nix package; it is kept for the upstream keytar setup.
[Unit]
Description=Proton Drive FUSE mount (unofficial) — account %i
Documentation=https://github.com/ProtonDriveApps/sdk
After=network-online.target graphical-session.target
Wants=network-online.target

[Service]
Type=simple
# See protondrive-nemo.service for why nvm.sh is sourced directly rather
# than relying on a plain `node` on PATH. %i is the instance name after the
# `@` (e.g. `work` for protondrive-nemo@work.service), passed straight
# through as --account; the CLI validates it against [A-Za-z0-9_-]+ before
# using it in any path or credentials-file lookup.
ExecStart=/bin/bash -c 'source %h/.nvm/nvm.sh && node %h/protondrive-nemo/dist/cli.js mount --account %i'
ExecStop=/bin/bash -c 'source %h/.nvm/nvm.sh && node %h/protondrive-nemo/dist/cli.js unmount --account %i'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
